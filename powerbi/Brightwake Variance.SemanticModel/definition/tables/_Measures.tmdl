	measure 'Gross Margin Actual' = [Revenue Actual] - [COGS Actual]
		formatString: 0
		lineageTag: 460287da-bed4-427e-ad88-178fd1d60251

	measure 'Gross Margin Budget' = [Revenue Budget] - [COGS Budget]
		formatString: 0
