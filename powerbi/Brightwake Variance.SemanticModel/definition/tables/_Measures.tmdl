	measure 'GM % Actual' = DIVIDE ( [Gross Margin Actual], [Revenue Actual] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 5ee24762-03bc-4515-8036-cb80e5aa5acc

	measure 'GM % Budget' = DIVIDE ( [Gross Margin Budget], [Revenue Budget] )
