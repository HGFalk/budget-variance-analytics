table _Measures
	lineageTag: c9b6240f-15cf-436b-a71d-b3bba76a2d9a

	measure 'Revenue Actual' = ```
			
			        CALCULATE (
			            SUM ( fct_pl_monthly[pl_amount_nok] ),
			            fct_pl_monthly[scenario] = "actual",
			            fct_pl_monthly[account_type] = "Revenue"
			        )
			```
		formatString: 0
