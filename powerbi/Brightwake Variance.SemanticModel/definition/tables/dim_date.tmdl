table dim_date
	lineageTag: ef227ca9-bbba-4a0b-a0c0-929d1b567e06
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 673d1ddf-e8e2-432a-b969-fa440423eda4
